{
  "name": "goduk-ko",
  "version": "2.0.0",
  "private": true,
  "description": "고덕 KO · 베이징 여행용 한국어 지도 (정적 PWA, 빌드 없음)",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.mjs --trace off",
    "test": "npm run test:unit && npm run test:e2e",
    "build:data": "node tools/build-subway.mjs && node tools/build-places.mjs && node tools/validate-data.mjs",
    "build:exits": "node tools/parse-zhwiki.mjs ${ZHWIKI_DIR:-/tmp/zhwiki} && node tools/validate-data.mjs",
    "build:tokens": "node ../design/build-tokens.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.63.0"
  }
}
